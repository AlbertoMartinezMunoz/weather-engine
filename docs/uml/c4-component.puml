@startuml
!include <C4/C4_Component>

skinparam maxMessageSize 100

AddRelTag("invisible", $textColor="transparent", $lineColor="transparent", $lineStyle = DashedLine())

header Weather Engine
title Weather Engine - C4 Component Diagram

'----------------------------------------------------------------
'Actors
'----------------------------------------------------------------
Person(user, "Weather Engine User", "Obtains an API key and accesses weather forecasts.",$type="Person")

'----------------------------------------------------------------
'Components
'----------------------------------------------------------------
Boundary(weatherEngine, "Weather Engine", $type="Software System") {
    Boundary(batchApp, "Batch Processing Application", $type="Container") {
        Component(acquireScript, "acquire.py", "Component: Python script", "Entry point for meteorological data acquisition.")
        Component(acquisition, "Data Acquisition", "Component: Python package", "Retrieves historical meteorological observations from AEMET.")
        Component(dataRepository, "Data Repository", "Component: Python package", "Reads and writes raw observations.")
    }
    ContainerDb_Ext(fileStorage, "File Storage", "Container: Local filesystem", "Stores raw data, processed datasets, forecasts, models and execution metadata.")
}

System_Ext(aemet, "AEMET OpenData", "Provides historical meteorological observations through its Open Data API.", $type="Software System")
Container_Ext(cron, "Scheduler", "Container: Cron", "Triggers periodic execution of batch processing scripts.")

'----------------------------------------------------------------
'Relations
'----------------------------------------------------------------
Rel(cron, acquireScript, "Executes periodically")
Rel(user, acquireScript, "Executes")
Rel(acquireScript, acquisition, "Invokes")
Rel_R(acquisition, aemet, "Retrieves weather raw data", "HTTPS / REST API")
Rel(acquisition, dataRepository, "Stores raw observations")
Rel(dataRepository, fileStorage, "Reads and writes data files")

'----------------------------------------------------------------
'Layout
'----------------------------------------------------------------
'Rel_L(xxx, xxx, "This rel is just to compose the layout", $tags="invisible")

SHOW_LEGEND()

@enduml
