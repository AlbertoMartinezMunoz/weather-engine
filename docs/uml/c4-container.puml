@startuml
!include <C4/C4_Container>

AddRelTag("invisible", $textColor="transparent", $lineColor="transparent", $lineStyle = DashedLine())

header Weather Engine
title Weather Engine - C4 Container Diagram

'----------------------------------------------------------------
'Actors
'----------------------------------------------------------------
Person(user, "Weather Engine User", "Obtains an API key and accesses weather forecasts.",$type="Person")

'----------------------------------------------------------------
'Components
'----------------------------------------------------------------
Boundary(weatherEngine, "Weather Engine", $type="Software System") {
    Container(webApp, "Web Application", "Container: Python, Flask, HTML, CSS", "Provides the user interface and REST API to consult weather forecasts and historical observations.")
    ContainerDb(fileStorage, "File Storage", "Container: Local file system", "Stores raw meteorological data, processed datasets and trained model artifacts.")
    Container(batchApp, "Batch Processing Application", "Container: Python, PyTorch", "Executes data acquisition, data engineering, model training and forecast generation.")
}

Container_Ext(cron, "Linux scheduler", "Container: Cron", "Executes scheduled scripts.")

System_Ext(aemet, "AEMET OpenData", "Provides historical meteorological observations through its Open Data API.", $type="Software System")


'----------------------------------------------------------------
'Relations
'----------------------------------------------------------------
Rel_R(user, aemet, "Requests an API key", "HTTPS")
Rel(user, webApp, "Views forecasts and historical data", "HTTPS")
Rel_L(cron, batchApp, "Triggers scheduled jobs", "Process execution")
Rel_U(batchApp, aemet, "Retrieves meteorological observations", "REST API")
Rel(batchApp, fileStorage, "Reads and writes raw data, datasets and model artifacts", "Parquet/JSON/Pytorch")
Rel(batchApp, fileStorage, "Reads and writes metadata, observations and forecasts", "JSON")
Rel(webApp, fileStorage, "Reads forecasts and historical observations", "JSON")


'----------------------------------------------------------------
'Layout
'----------------------------------------------------------------
'Rel_D(xxx, xxx, "This rel is just to compose the layout", $tags="invisible")

SHOW_LEGEND()

@enduml
